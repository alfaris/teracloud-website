# Copy to .env.local for development, or to the server's env file in production.

# --- Contact form email -------------------------------------------------------
# Company mail server (preferred when self-hosting). Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Or Resend, used only when SMTP_HOST is empty.
RESEND_API_KEY=
# Where messages go. Optional per-topic inboxes override CONTACT_TO.
CONTACT_TO=info@teracloud.com
CONTACT_TO_PARTNERSHIP=
CONTACT_TO_CAREERS=
CONTACT_TO_GENERAL=
CONTACT_FROM=Teracloud website <website@teracloud.com>
# Without SMTP_HOST or RESEND_API_KEY the form logs to the console in
# development and shows a "can't send" message in production.

# --- Analytics (build time) ---------------------------------------------------
# Cookieless Plausible analytics; leave empty to turn analytics off.
# For self-hosted Plausible, also set the script URL on your Plausible server.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
