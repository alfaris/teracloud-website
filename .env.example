# Copy to .env.local. Leave SANITY_PROJECT_ID empty to serve the content in
# src/content instead of Sanity. See README → Content (Sanity).

# Sanity project (sanity.io/manage → project → Project ID). Not secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Shared secret for the publish webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Only for `npm run sanity:seed`: an API token with Editor rights. Keep it out
# of the deployed environment.
SANITY_API_WRITE_TOKEN=
